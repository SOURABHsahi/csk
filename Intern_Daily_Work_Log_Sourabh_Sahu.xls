<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="utf-8">
<style>
  th { background-color: #f7cbb1; color: #000; font-family: Calibri, sans-serif; font-weight: bold; text-align: center; border: 1px solid #d99b78; padding: 8px 12px; font-size: 11pt; }
  td { font-family: Calibri, sans-serif; border: 1px solid #d3d3d3; padding: 8px 12px; font-size: 10.5pt; vertical-align: middle; }
  .center { text-align: center; }
  .status { font-weight: bold; color: #0e6251; background-color: #d4efdf; text-align: center; }
</style>
</head>
<body>
<table>
  <thead>
    <tr>
      <th>S.No.</th>
      <th>Intern Name</th>
      <th>Technology</th>
      <th>Topic</th>
      <th>Description</th>
      <th>Start Date</th>
      <th>End Date</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="center">1</td>
      <td>Sourabh Sahu</td>
      <td>ASP.NET Core 10, React, JWT</td>
      <td><b>Centralized Single Sign-On (SSO) & Auth Federation</b></td>
      <td>Integrated Employee Hub IdP with Knome Platform, configured multi-issuer JWT HS256 validation, and setup BCrypt password verification.</td>
      <td class="center">04-08-2026</td>
      <td class="center">04-08-2026</td>
      <td class="status">Completed</td>
    </tr>
    <tr>
